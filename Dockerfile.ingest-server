FROM node:22-slim AS base
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY . .
RUN corepack pnpm install --frozen-lockfile
# 런타임 의존 순서대로 빌드
RUN corepack pnpm --filter @qa-sdk/pino run build && \
    corepack pnpm --filter test-types run build && \
    corepack pnpm --filter @qa-sdk/core run build && \
    corepack pnpm --filter @qa-sdk/otel run build && \
    corepack pnpm --filter @qa-sdk/codec-proto run build && \
    corepack pnpm --filter @qa-sdk/engine run build && \
    corepack pnpm --filter @qa-sdk/registry-client run build && \
    corepack pnpm --filter @qa-sdk/store run build && \
    corepack pnpm --filter index-meta run build && \
    corepack pnpm --filter @qa-sdk/ingest-server run build

FROM node:22-slim AS production
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/packages/ingest-server
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3200
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["sh", "-c", "curl -fsS http://localhost:${PORT:-3200}/health/live || exit 1"]
CMD ["node", "dist/server.js"]
