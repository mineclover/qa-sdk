FROM node:22-slim AS base
RUN corepack enable pnpm

FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
# 로컬에서 미리 빌드된 dist/ 사용 — Docker 안에서는 의존 설치만
# 빌드가 필요하면: pnpm --filter @qa-sdk/ingest-server... run build
# Docker 빌드 전 로컬에서 실행 필요:
#   pnpm --filter @qa-sdk/ingest-server... run build

FROM node:22-slim AS production
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/packages/ingest-server
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3200
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["sh", "-c", "curl -fsS http://localhost:${PORT:-3200}/health/live || exit 1"]
CMD ["node", "dist/server.js"]
