# ── 정적 사이트 범용 Dockerfile ──────────────────────────────
# 사용법:
#   docker build -f Dockerfile.static --build-arg SITE=shop-web -t shop-web .
#   docker build -f Dockerfile.static --build-arg SITE=platform-demo -t platform-demo .
#
# config.js 교체:
#   docker run -v $(pwd)/config.prod.js:/usr/share/nginx/html/config.js shop-web

ARG SITE=shop-web

# ── Build (platform-demo만 Vite 빌드 필요) ────────────────
FROM node:22-slim AS build
RUN corepack enable pnpm
WORKDIR /app
COPY . .
ARG SITE
RUN if [ "$SITE" = "platform-demo" ]; then \
      pnpm install --frozen-lockfile && \
      pnpm --filter platform-demo build; \
    fi
# 통합 출력 디렉토리 생성: platform-demo → dist/, shop-web → public/
RUN mkdir -p /out && \
    if [ "$SITE" = "platform-demo" ] && [ -d "packages/$SITE/dist" ]; then \
      cp -r packages/$SITE/dist/* /out/; \
    else \
      cp -r packages/$SITE/public/* /out/; \
    fi

# ── Serve ──────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=build /out/ /usr/share/nginx/html/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/health || exit 1
