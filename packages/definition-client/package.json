{
  "name": "@qa-sdk/definition-client",
  "version": "0.1.0",
  "description": "definition-service REST surface용 타입 안전 HTTP 클라이언트",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
