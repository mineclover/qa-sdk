# ── Local development ──────────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Run: pnpm dev:ingest

# PostgreSQL connection string (local Docker)
TRACE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/qa_sdk

# HTTP port the server listens on
PORT=3100

# Registry validation — set to "off" for local dev (no registry-server running)
# Options: strict | warn | off
REGISTRY_VALIDATION_MODE=off

# ── Optional tuning ────────────────────────────────────────────
# REGISTRY_URL=http://localhost:3001
# SSE_SUBSCRIPTION_LIMIT=10
# DLQ_MAX_RETRY_ATTEMPTS=3
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# CLEANUP_CRON_ENABLED=false
