    "@qa-sdk/codec-proto": "workspace:*",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/engine": "workspace:*",
    "@qa-sdk/otel": "workspace:*",
    "@qa-sdk/registry-client": "workspace:*",
    "@qa-sdk/store": "workspace:*",
    "bullmq": "^5.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "catalog:",
    "hono": "^4.7.5",
    "index-meta": "workspace:*",
    "pino": "workspace:@qa-sdk/pino@*",
