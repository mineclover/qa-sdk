{
  "name": "demo-dkg-config",
  "version": "0.1.0",
  "description": "DEMO DKG bootstrap 설정 데이터 (decision-flow flow schema 포함)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
