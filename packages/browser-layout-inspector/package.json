{
  "name": "browser-layout-inspector",
  "version": "0.1.0",
  "description": "Browser-native CSS provenance, computed-style, geometry, and position inspection for extension content scripts.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./measurement": {
      "types": "./dist/measurement.d.ts",
      "import": "./dist/measurement.js",
      "require": "./dist/measurement.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "happy-dom": "^20.8.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
