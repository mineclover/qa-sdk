{
  "name": "@qa-sdk/spec-core",
  "version": "0.1.0",
  "description": "spec registry, propagation, codegen, transition, DKG bridge를 담는 spec 엔진 커널",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codegen": {
      "import": "./dist/codegen/index.js",
      "types": "./dist/codegen/index.d.ts"
    },
    "./dkg": {
      "import": "./dist/dkg/index.js",
      "types": "./dist/dkg/index.d.ts"
    },
    "./propagation": {
      "import": "./dist/propagation/index.js",
      "types": "./dist/propagation/index.d.ts"
    },
    "./viz": {
      "import": "./dist/visualization/index.js",
      "types": "./dist/visualization/index.d.ts"
    },
    "./transition": {
      "import": "./dist/transition/index.js",
      "types": "./dist/transition/index.d.ts"
    },
    "./semantic-indexing-pack": {
      "import": "./dist/semantic-indexing-pack/index.js",
      "types": "./dist/semantic-indexing-pack/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qa-sdk/core": "workspace:*",
    "dkg": "workspace:*",
    "spec-schema": "workspace:*",
    "spec-transition": "workspace:*",
    "weighted-index": "workspace:*"
  },
  "devDependencies": {
    "@qa-sdk/convergence": "workspace:*",
    "@types/node": "^22.20.5",
    "demo-dkg-config": "workspace:*",
    "demo-snapshot": "workspace:*",
    "dkg-enrichment": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
