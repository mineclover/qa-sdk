{
  "name": "ralph-tui-integration",
  "version": "0.1.0",
  "description": "ralph-tui integration — adapters + completion detection specific to ralph-tui's `.ralph-tui/` session state and flat-root JSON PRD format. Isolated from doc-envelope collection layer.",
  "keywords": [
    "adapter",
    "doc-envelope",
    "integration",
    "ralph-tui"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "doc-envelope": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
