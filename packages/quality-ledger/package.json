{
  "name": "quality-ledger",
  "version": "0.1.0",
  "description": "품질 게이트 실행 결과 원장 — SQLite 기반 gate 검증 상태 추적",
  "license": "MIT",
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "index-meta": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
