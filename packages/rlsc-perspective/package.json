{
  "name": "@qa-sdk/rlsc-perspective",
  "version": "0.1.0",
  "description": "Reusable RLSC 3D perspective viewer",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "smoke:consumer": "node smoke/consumer.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qa-sdk/rlsc-analysis": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.8.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
