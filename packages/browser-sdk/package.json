{
  "name": "@qa-sdk/browser",
  "version": "0.1.0",
  "private": true,
  "description": "QaMonitor, session, auto-capture를 제공하는 브라우저 수집 SDK",
  "type": "module",
  "main": "dist/qa-browser-sdk.umd.cjs",
  "module": "dist/qa-browser-sdk.js",
  "exports": {
    ".": {
      "import": "./dist/qa-browser-sdk.js",
      "require": "./dist/qa-browser-sdk.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qa-sdk/browser-codec": "workspace:*",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/event-catalog": "workspace:*",
    "@qa-sdk/sdk": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.8.4",
    "typescript": "^5.8.2",
    "vite": "^6.3.5"
  }
}
