# ── Local development ──────────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Run: pnpm dev:viz

# Ingest server endpoint (REST + WebSocket)
VITE_INGEST_SERVER_URL=http://localhost:3100

# URL of the roleplay-web iframe
# Must match VITE_VIZ_WEB_ORIGIN in packages/roleplay-web/.env
VITE_ROLEPLAY_WEB_URL=http://localhost:5201
