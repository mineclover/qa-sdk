{
  "name": "@qa-sdk/archi",
  "version": "0.1.0",
  "description": "Architecture Definition CLI Platform — Manage architecture as code & templates",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archi": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "inquirer": "^9.3.2",
    "js-yaml": "^4.1.0",
    "chalk": "^5.3.0",
    "tinyglobby": "^0.2.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/inquirer": "^9.0.7",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
