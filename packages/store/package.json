{
  "name": "@qa-sdk/store",
  "version": "0.1.0",
  "description": "EventRecord, Trace, Session, Verdict 등의 저장소 어댑터 집합",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run src/adapters/drizzle/*.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qa-sdk/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.5"
  },
  "optionalDependencies": {
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@qa-sdk/otel": "workspace:*",
    "@types/node": "^22.13.10",
    "drizzle-kit": "catalog:",
    "typescript": "^5.8.2"
  }
}
