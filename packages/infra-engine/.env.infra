# MinIO S3 호환 endpoint (로컬 개발용)
INFRA_AWS_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=ap-northeast-2

# Pulumi — MinIO S3 백엔드
PULUMI_CONFIG_PASSPHRASE=
PULUMI_BACKEND_URL=s3://qa-sdk-infra-state?endpoint=http://localhost:9000&disableSSL=true&s3ForcePathStyle=true

# SOPS — age 키 (로컬, KMS 불필요)
# SOPS_AGE_KEY_FILE=~/.sops/age/keys.txt

# K8s
KUBECONFIG_CONTEXT=k3d-qa-local
