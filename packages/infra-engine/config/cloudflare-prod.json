{
  "global": {
    "region": "global"
  },
  "services": {
    "decode-service": {
      "port": 443,
      "depends_on": ["registry-service"]
    },
    "gate-service": {
      "port": 443,
      "depends_on": ["registry-service", "ingest-server"]
    },
    "query-service": {
      "port": 443,
      "depends_on": ["gate-service"]
    },
    "registry-service": {
      "port": 443
    },
    "ingest-server": {
      "port": 443
    },
    "gateway": {
      "port": 443
    }
  },
  "connections": {
    "decode-service": {
      "endpoint": "https://qa-decode-service.astralclover.workers.dev",
      "health_path": "/health"
    },
    "gate-service": {
      "endpoint": "https://qa-gate-service.astralclover.workers.dev",
      "health_path": "/health"
    },
    "query-service": {
      "endpoint": "https://qa-query-service.astralclover.workers.dev",
      "health_path": "/health"
    },
    "registry-service": {
      "endpoint": "https://qa-registry-service.astralclover.workers.dev",
      "health_path": "/health"
    },
    "ingest-server": { "endpoint": "https://ingest.qa-sdk.io", "health_path": "/health/live" },
    "gateway": {
      "endpoint": "https://qa-gateway.astralclover.workers.dev",
      "health_path": "/health"
    }
  },
  "monitoring": {
    "interval": 60,
    "recovery": {
      "enabled": false,
      "maxRetries": 2,
      "cooldownSec": 600
    }
  }
}
