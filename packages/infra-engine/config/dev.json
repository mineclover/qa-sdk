{
  "global": {
    "region": "ap-northeast-2"
  },
  "services": {
    "ingest-server": {
      "port": 3200,
      "store_driver": "d1",
      "cors_origin": "*",
      "health_path": "/health/live",
      "registry_url": "http://registry-service-svc:3300",
      "depends_on": ["registry-service"]
    },
    "registry-service": {
      "port": 3300
    },
    "gate-service": {
      "port": 3400,
      "depends_on": ["registry-service", "ingest-server"]
    },
    "query-service": {
      "port": 3500,
      "depends_on": ["gate-service"]
    },
    "decode-service": {
      "port": 3600
    },
    "decision-service": {
      "port": 3800,
      "health_path": "/health",
      "depends_on": ["registry-service"]
    },
    "definition-service": {
      "port": 3700,
      "health_path": "/health",
      "depends_on": ["registry-service"]
    },
    "motion-workspace": {
      "port": 3710,
      "health_path": "/health"
    }
  },
  "connections": {
    "ingest-server": { "endpoint": "http://localhost:3200" },
    "registry-service": { "endpoint": "http://localhost:3300" },
    "gate-service": { "endpoint": "http://localhost:3400" },
    "query-service": { "endpoint": "http://localhost:3500" },
    "decode-service": { "endpoint": "http://localhost:3600" },
    "decision-service": { "endpoint": "http://localhost:3800" },
    "definition-service": { "endpoint": "http://localhost:3700" },
    "motion-workspace": { "endpoint": "http://localhost:3710" }
  },
  "monitoring": {
    "interval": 60
  }
}
