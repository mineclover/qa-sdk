# Local infra template. Copy to .env.docker and replace placeholders locally.
INFRA_AWS_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=qa-sdk-local
AWS_SECRET_ACCESS_KEY=__generate_with_openssl_rand_hex_32__
AWS_DEFAULT_REGION=ap-northeast-2
MINIO_ROOT_USER=qa-sdk-local
MINIO_ROOT_PASSWORD=__generate_with_openssl_rand_hex_32__
PULUMI_CONFIG_PASSPHRASE=__generate_with_openssl_rand_hex_32__
PULUMI_BACKEND_URL=s3://qa-sdk-infra-state?endpoint=http://localhost:9000&disableSSL=true&s3ForcePathStyle=true
KUBECONFIG_CONTEXT=k3d-qa-local
STORE_DRIVER=d1
SQLITE_PATH=~/.qa-sdk/ingest.sqlite
