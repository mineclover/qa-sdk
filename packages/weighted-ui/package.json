{
  "name": "weighted-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared UI components and design tokens for weighted-index apps",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/green": "./dist/styles/tokens/green.css",
    "./styles/navy": "./dist/styles/tokens/navy.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "weighted-index": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "weighted-index": "workspace:*"
  }
}
