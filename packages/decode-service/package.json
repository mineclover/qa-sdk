{
  "name": "@qa-sdk/decode-service",
  "version": "0.1.0",
  "private": true,
  "description": "DecodeMap 기반 주소 디코딩 API 서비스",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/logger": "workspace:*",
    "@qa-sdk/store": "workspace:*",
    "dotenv": "^17.3.1",
    "hono": "^4.7.5",
    "index-meta": "workspace:*",
    "index-meta-workers": "workspace:*",
    "ioredis": "^5.10.1",
    "pino": "workspace:@qa-sdk/pino@*",
    "weighted-index": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "wrangler": "^4.76.0"
  }
}
