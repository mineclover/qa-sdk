{
  "name": "sim-internal-network",
  "version": "0.1.0",
  "description": "internal IP 검증 (docker network/loopback) — NestJS Guard + Hono middleware",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "hono": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@types/node": "^22.0.0",
    "hono": "^4.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
