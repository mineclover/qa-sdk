{
  "name": "@qa-sdk/nest-service-kit",
  "version": "0.1.0",
  "description": "NestJS modular-monolith service bootstrap + event/outbox standard kit",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
