{
  "name": "db-traffic-control",
  "version": "0.1.0",
  "description": "DB 트래픽 제어 — 쿼리별 버짓 기반 동시성/QPS 제한 + Drizzle 미들웨어",
  "keywords": [
    "budget",
    "concurrency",
    "database",
    "drizzle",
    "rate-limit",
    "sqlcommenter",
    "traffic-control"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
