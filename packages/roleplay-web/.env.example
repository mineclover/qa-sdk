# ── Local development ──────────────────────────────────────────
# Copy this file to .env and adjust as needed.
# Run: pnpm dev:roleplay

# Ingest server endpoint for QA event collection
VITE_INGEST_SERVER_URL=http://localhost:3200

# Origin of viz-web — must match viz-web's actual dev port
# viz-web checks this to validate postMessage sender
VITE_VIZ_WEB_ORIGIN=http://localhost:5200
