{
  "name": "@qa-sdk/cli",
  "version": "0.1.0",
  "description": "QA-SDK CLI — APM schema management and code generation",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qa-sdk": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter cli-command build && tsup",
    "dev": "pnpm --filter cli-command build && tsup --watch",
    "test": "pnpm --filter cli-command build && vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@qa-sdk/convergence": "workspace:*",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/spec-core": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "codegen-core": "workspace:*",
    "cli-command": "workspace:*",
    "config-loader": "workspace:*",
    "decision-flow": "workspace:*",
    "decision-flow-store": "workspace:*",
    "definition-catalog": "workspace:*",
    "definition-data-source": "workspace:*",
    "demo-snapshot": "workspace:*",
    "dkg": "workspace:*",
    "drizzle-orm": "1.0.0-beta.20",
    "execa": "^9.6.1",
    "git-utils": "workspace:*",
    "index-meta": "workspace:*",
    "motion-content": "workspace:*",
    "motion-workspace": "workspace:*",
    "motion-workspace-client": "workspace:*",
    "package-classifier": "workspace:*",
    "quality-ledger": "workspace:*",
    "review-ledger": "workspace:*",
    "snapshot-io": "workspace:*",
    "spec-analyzer": "workspace:*",
    "spec-tracker": "workspace:*",
    "spec-transition": "workspace:*",
    "test-scenario-store": "workspace:*",
    "test-types": "workspace:*",
    "work-domain": "workspace:*"
  },
  "devDependencies": {
    "@qa-sdk/motion-workspace-service": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "drizzle-kit": "1.0.0-beta.20",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
