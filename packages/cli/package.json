{
  "name": "@qa-sdk/cli",
  "version": "0.1.0",
  "description": "QA-SDK CLI — APM schema management and code generation",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qa-sdk": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/spec-core": "workspace:*",
    "decision-flow": "workspace:*",
    "definition-catalog": "workspace:*",
    "demo-snapshot": "workspace:*",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
