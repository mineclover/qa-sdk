{
  "name": "@qa-sdk/motion-workspace-service",
  "version": "0.1.0",
  "private": true,
  "description": "workspace CRUD와 revision 기반 동시성 제어를 제공하는 서비스",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "build:tsc": "tsc",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/node-ws": "^1.3.0",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/logger": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.7.5",
    "index-meta": "workspace:*",
    "motion-workspace": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "catalog:",
    "motion-content": "workspace:*",
    "motion-workspace-client": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
