{
  "name": "@qa-sdk/core",
  "version": "0.1.0",
  "description": "카탈로그, 타입, 서비스 포트, 좌표 유틸리티를 담는 QA-SDK 코어",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./coordinates/*": {
      "types": "./dist/coordinates/*.d.ts",
      "import": "./dist/coordinates/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "definition-catalog": "workspace:*",
    "pino": "workspace:@qa-sdk/pino@*",
    "test-types": "workspace:*",
    "ulid": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "spec-tracker": "workspace:*",
    "typescript": "^5.8.2",
    "vitest": "^1.6.1"
  }
}
