{
  "name": "visbug-bridge",
  "version": "0.1.0",
  "description": "qa-sdk bridge to vendor/projectvisbug — typed Web Component mount + edit-log listener API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "pnpm --filter visbug run bundle && pnpm build && pnpm exec http-server ../.. -p 4173 -c-1",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "visbug": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0"
  }
}
