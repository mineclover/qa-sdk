{
  "name": "@qa-sdk/registry-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/node-ws": "^1.3.0",
    "hono": "^4.7.5",
    "ws": "^8.19.0",
    "index-meta": "workspace:*",
    "weighted-index": "workspace:*",
    "pino": "workspace:@qa-sdk/pino@^9.9.4",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@qa-sdk/spec-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qa-sdk/spec-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qa-sdk/spec-core": "workspace:*",
    "demo-snapshot": "workspace:*",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3"
  }
}
