{
  "name": "@qa-sdk/registry-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@qa-sdk/core": "workspace:*",
    "pipe-store-sqlite": "workspace:*",
    "@qa-sdk/otel": "workspace:*",
    "@qa-sdk/definition-client": "workspace:*",
    "@qa-sdk/event-catalog": "workspace:*",
    "@qa-sdk/logger": "workspace:*",
    "definition-catalog": "workspace:*",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-beta.20",
    "index-meta": "workspace:*",
    "pino": "workspace:@qa-sdk/pino@*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "weighted-index": "workspace:*",
    "ws": "^8.19.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@qa-sdk/spec-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qa-sdk/spec-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.20",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@qa-sdk/spec-core": "workspace:*",
    "@types/node": "^22.13.10",
    "demo-snapshot": "workspace:*",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3",
    "wrangler": "^4.73.0"
  }
}
