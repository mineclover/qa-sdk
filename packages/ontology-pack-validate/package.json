{
  "name": "ontology-pack-validate",
  "version": "0.1.0",
  "description": "Ontology pack validation — load/resolve pack references, validate identity/component/runtime, collect file and docs readiness.",
  "keywords": [
    "ontology-pack",
    "readiness",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "authorization-ontology": "workspace:*",
    "definition-catalog": "workspace:*",
    "doc-envelope": "workspace:*",
    "operational-ontology": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
