# Copy this file to `.env` before running `docker compose up --build`.

# PostgreSQL bootstrap settings used by the `postgres` service.
POSTGRES_DB=qa_sdk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Internal connection string for registry-server and its migration step.
# Keep the host as `postgres` so containers can resolve the Compose service.
REGISTRY_DATABASE_URL=postgres://postgres:postgres@postgres:5432/qa_sdk

# Internal connection string for ingest-server and the shared store migration.
TRACE_DATABASE_URL=postgres://postgres:postgres@postgres:5432/qa_sdk

# Host ports published by Docker Compose.
REGISTRY_SERVER_PORT=3001
INGEST_SERVER_PORT=3002

# Ingest-server runtime tuning.
INGEST_SSE_SUBSCRIPTION_LIMIT=10
INGEST_DLQ_MAX_RETRY_ATTEMPTS=3
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX_REQUESTS=100

# Registry validation from ingest-server.
# Default URL targets the registry-server container inside the Compose network.
INGEST_REGISTRY_URL=http://registry-server:3001
INGEST_REGISTRY_VALIDATION_MODE=warn
