# ══════════════════════════════════════════════════════════════
#  Docker Compose — copy this file to .env before running:
#    docker compose up --build
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL bootstrap (docker postgres service) ─────────────
POSTGRES_DB=qa_sdk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Database URLs (inside Docker network, host = "postgres") ───
TRACE_DATABASE_URL=postgres://postgres:postgres@postgres:5432/qa_sdk

# ── Host ports exposed by Docker Compose ──────────────────────
INGEST_SERVER_PORT=3200

# ── Layer 2 services (optional — docker compose up gate-service 등) ──
REGISTRY_SERVICE_PORT=3300
DECODE_SERVICE_PORT=3600
GATE_SERVICE_PORT=3400
QUERY_SERVICE_PORT=3500

# ── Ingest-server tuning ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_ENABLED=true
WORKER_CONCURRENCY=5
INGEST_SSE_SUBSCRIPTION_LIMIT=10
INGEST_DLQ_MAX_RETRY_ATTEMPTS=3
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX_REQUESTS=100

# ── Registry validation ────────────────────────────────────────
# Targets the registry-service container inside the Compose network
INGEST_REGISTRY_URL=http://registry-service:3300
INGEST_REGISTRY_VALIDATION_MODE=warn

# ── Backup ────────────────────────────────────────────────────
BACKUP_DIR=/backup
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=90
BACKUP_MAX_AGE_HOURS=24
# BACKUP_CRON_SCHEDULE=0 2 * * *

# ── HA (docker-compose.ha.yml 전용) ──────────────────────────
# POSTGRES_REPLICA_URL=postgres://postgres:postgres@postgres-replica:5432/qa_sdk
# REDIS_SENTINEL_URLS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# GRAFANA_ADMIN_PASSWORD=admin

# ══════════════════════════════════════════════════════════════
#  Local development (without Docker) — see each package's own
#  .env.example for per-package settings:
#
#    packages/ingest-server/.env.example  →  PORT, TRACE_DATABASE_URL, REDIS_URL
#    packages/viz-web/.env.example        →  VITE_INGEST_SERVER_URL, VITE_ROLEPLAY_WEB_URL
#    packages/roleplay-web/.env.example   →  VITE_INGEST_SERVER_URL, VITE_VIZ_WEB_ORIGIN
#    packages/store/.env.example          →  DATABASE_URL (integration tests only)
#
#  Quick start (each command in a separate terminal):
#    docker compose up postgres            # start DB only
#    pnpm dev:ingest                       # http://localhost:3100
#    pnpm dev:viz                          # http://localhost:5200
#    pnpm dev:roleplay                     # http://localhost:5201
# ══════════════════════════════════════════════════════════════
