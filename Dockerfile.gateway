# Dockerfile.gateway — Gateway (Hono Node.js) 전용
# 사용: docker build -t qa-sdk/gateway:latest -f Dockerfile.gateway .
FROM node:22-slim AS base
RUN corepack enable pnpm

FROM base AS build
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ packages/
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @qa-sdk/gateway build

FROM node:22-slim AS production
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app/packages/gateway
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD ["sh", "-c", "curl -fsS http://localhost:${PORT:-8787}/health || exit 1"]
CMD ["node", "dist/server.js"]
