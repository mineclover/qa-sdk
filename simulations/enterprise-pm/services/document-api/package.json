    "@qa-sdk/sim-bitmap-cache": "workspace:*",
    "@qa-sdk/sim-domain-slice-kit": "workspace:*",
    "@qa-sdk/sim-otel-utils": "workspace:*",
    "db-bootstrap": "workspace:*",
    "drizzle-orm": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "better-sqlite3": "catalog:",
    "postgres": "^3.4.0"
