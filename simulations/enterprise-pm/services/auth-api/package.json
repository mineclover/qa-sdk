{
  "name": "@qa-sdk/sim-auth-api",
  "version": "0.1.0",
  "private": true,
  "description": "시뮬 — 사용자/role/department + bitmap 발행 NestJS 서비스",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    },
    "./test-bootstrap": {
      "import": "./dist/test-bootstrap.js",
      "types": "./dist/test-bootstrap.d.ts"
    },
    "./auth-codec": {
      "import": "./dist/auth/bitmap/infrastructure/codec/auth-codec.js",
      "types": "./dist/auth/bitmap/infrastructure/codec/auth-codec.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:gen:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:gen:pg": "drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@qa-sdk/core": "workspace:*",
    "@qa-sdk/logger": "workspace:*",
    "@qa-sdk/otel": "workspace:*",
    "@qa-sdk/sim-bitmap-cache": "workspace:*",
    "@qa-sdk/sim-domain-slice-kit": "workspace:*",
    "db-bootstrap": "workspace:*",
    "drizzle-orm": "catalog:",
    "permission-engine": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sim-identifier-grammar": "workspace:*",
    "sim-internal-network": "workspace:*",
    "weighted-index": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "^22.20.5",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "postgres": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "better-sqlite3": "catalog:",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  }
}
