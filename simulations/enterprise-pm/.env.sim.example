# Enterprise PM 시뮬 환경 변수 — 평문 예제 (실제 값은 .env.sim.enc에서 복호화)
#
# 사용 절차:
#   1. sops decrypt .env.sim.enc > .env.sim
#   2. (필요 시) .env.sim 편집
#   3. pnpm sim:up

# ── 데이터베이스 (qa-sdk-db 컨테이너) ──
QA_DB_DIALECT=pg
QA_PG_HOST=qa-sdk-db          # docker network 안에서는 컨테이너명, 호스트에서는 localhost
QA_PG_PORT=5432               # docker network 안 내부 포트 (호스트 노출은 5434)
QA_PG_DATABASE=qa_sdk
QA_PG_USER=sim_app            # Plan 09b에서 생성됨
QA_PG_PASSWORD=__from_sops__  # 실제 값은 .env.sim.enc — Plan 09b의 QA_SDK_SIM_PASSWORD와 동일
QA_PG_SCHEMA=sim

# Read replica routing (Plan A 단계 4)
SIM_DB_WRITE_URL=postgres://sim_app:__from_sops__@qa-sdk-db:5432/qa_sdk
SIM_DB_READ_URL=postgres://replicator:__from_sops__@qa-sdk-db-replica:5432/qa_sdk

# ── 시뮬 인프라 ──
SIM_REDIS_URL=redis://sim-redis:6379

# ── 관측 (qa-sdk 본체로 forward) ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://qa-sdk-otel-collector:4318
QA_INGEST_URL=http://qa-sdk-ingest:3200
QA_PG_INGEST_PASSWORD=__from_sops__

# ── 시뮬 식별 ──
SIM_ENV=dev                   # dev | ci | demo
SIM_LOG_LEVEL=info            # debug | info | warn | error

# ── 게이트웨이 ──
SIM_JWT_SECRET=__from_sops__  # JWT 서명 키 (디자인 §2)
SIM_JWT_ISSUER=sim-auth-api
SIM_JWT_TTL_SECONDS=3600

# ── seed runner ──
SIM_SEED_DRY_RUN=false        # true → SQL 실행 안 하고 출력만

# ── 단계 8(Plan C): approval-api v1/v2 image tag (grammar #3, sim.svc.approval prefix) ──
APPROVAL_V1_TAG=v3
APPROVAL_V2_TAG=v4-candidate
QA_PG_APPROVAL_PASSWORD=__from_sops__

# ── 단계 9(Plan D): canary controller (Pass 1 + Pass 2 + 30s cycle) ──
SIM_CONTROLLER_ID=CTRL0001
SIM_CONTROLLER_CYCLE_MS=30000

# ── 시나리오 9 (canary-happy-promote) sim happy-path 진입점 ──
# production 운영에서는 모두 미설정. 시뮬에서만 활성화.
#   HEALTHY_METRICS=true       → controller 부팅 시 healthy-metrics fault 자동 enable
#                                (외부 metrics 미연결 환경에서 confidence=1.0 + 모든 PASS 합성)
#   DWELL_MS=4500              → controller-config.yaml dwell.promotionMs override
#                                (시뮬 cycle=5000ms 와 호환되도록 단축, 매 사이클마다 promote 진행)
#   CANDIDATE_VERSION=4        → weight=100 도달 시 catalog 에 candidate 시드 후 즉시
#                                stable 로 전이 (시나리오 9 catalog 전이 자동화)
SIM_CONTROLLER_HEALTHY_METRICS=false
# SIM_CONTROLLER_DWELL_MS=4500
# SIM_CONTROLLER_CANDIDATE_VERSION=4
