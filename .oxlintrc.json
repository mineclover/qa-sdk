{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/config-schema/src/public/schema/v1/oxlintrc.schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "perf": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "node", "promise"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-unused-vars": "off",

    "import/no-cycle": "off",
    "import/no-self-import": "error",
    "import/no-duplicates": "off",

    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "off",

    "no-unused-expressions": "off",

    "typescript/no-extraneous-class": "off",

    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "unicorn/no-process-exit": "off",
    "unicorn/no-new-array": "off",
    "unicorn/consistent-function-scoping": "off",

    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/test/**/*.ts",
        "**/__tests__/**/*.ts",
        "**/*.contract.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unused-vars": "off",
        "no-unused-expressions": "off",
        "unicorn/no-thenable": "off",
        "jest/require-to-throw-message": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "jest/no-conditional-expect": "off",
        "jest/valid-expect": "off",
        "vitest/expect-expect": "off",
        "jest/expect-expect": "off",
        "jest/valid-describe-callback": "off",
        "vitest/valid-expect": "off",
        "jest/no-standalone-expect": "off",
        "vitest/valid-title": "off",
        "jest/valid-title": "off",
        "jest/no-disabled-tests": "off",
        "vitest/no-disabled-tests": "off"
      }
    },
    {
      "files": ["**/*.shared.ts", "**/*.fixtures.ts", "**/*.helpers.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unused-vars": "off",
        "no-unused-expressions": "off",
        "unicorn/no-thenable": "off",
        "jest/require-to-throw-message": "off",
        "jest/no-export": "off",
        "jest/expect-expect": "off",
        "jest/no-conditional-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "jest/valid-expect": "off",
        "vitest/expect-expect": "off",
        "jest/valid-describe-callback": "off",
        "vitest/valid-expect": "off",
        "jest/no-standalone-expect": "off",
        "vitest/valid-title": "off",
        "jest/valid-title": "off",
        "jest/no-disabled-tests": "off",
        "vitest/no-disabled-tests": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".pnpm-store/",
    "drizzle/",
    "*.generated.*",
    "packages/demo-types/",
    "packages/weighted-wasm/pkg/",
    "packages/platform-demo/public/diagram-presets.js",
    "packages/platform-demo/public/viz-3d-core.js",
    "packages/shop-web/public/",
    "monitoring/",
    "verdaccio/",
    "scripts/"
  ]
}
