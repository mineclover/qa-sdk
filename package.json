{
  "name": "qa-sdk",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health.sh",
    "gate:event-taxonomy": "bash scripts/registry-event-taxonomy-gate.sh",
    "build": "corepack pnpm -r run build",
    "test": "corepack pnpm -r --workspace-concurrency=1 run test",
    "test:full": "QA_TEST_PG=1 SIM_SCENARIO_INPROC=1 corepack pnpm -r --workspace-concurrency=1 run test",
    "lint": "oxlint --deny-warnings packages/",
    "lint:fix": "oxlint --fix packages/",
    "lint:ci": "oxlint --format=github --deny-warnings packages/",
    "format": "node scripts/check-format.mjs --all --write",
    "format:check": "node scripts/check-format.mjs --all",
    "format:check:changed": "node scripts/check-format.mjs",
    "format:check:all": "node scripts/check-format.mjs --all",
    "arch:check": "tsx scripts/check-dependency-boundaries.ts",
    "arch:impact": "tsx scripts/api-impact-analyzer.ts",
    "arch:impact:baseline": "tsx scripts/api-impact-baseline.ts",
    "arch:usage": "tsx scripts/analyze-package-usage.ts",
    "arch:identity": "tsx scripts/identifier-mapper.ts",
    "arch:signals": "tsx scripts/discover-event-flow.ts",
    "arch:surfaces": "node scripts/report-package-surfaces.mjs",
    "arch:feedback": "tsx scripts/ai-feedback-loop.ts",
    "arch:verify": "tsx scripts/verify-analysis-os.ts",
    "arch:manifest": "tsx scripts/generate-api-reference.ts",
    "clean": "corepack pnpm -r run clean",
    "sync:skills": "bash scripts/sync-skills.sh",
    "skills:check": "node scripts/validate-skills.mjs",
    "def:check": "node packages/cli/dist/index.js def validate && node packages/cli/dist/index.js def audit-db",
    "docs:audit-quality": "node scripts/audit-doc-quality.mjs",
    "docs:usefulness-audit": "node scripts/design-usefulness-audit.mjs",
    "dev:ingest": "corepack pnpm --filter @qa-sdk/ingest-server dev",
    "dev:registry": "corepack pnpm --filter @qa-sdk/registry-service dev",
    "dev:shop": "corepack pnpm --filter @qa-sdk/shop-web dev",
    "dev:demo": "corepack pnpm --filter platform-demo dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:viz": "corepack pnpm --filter @qa-sdk/viz-web dev",
    "dev:roleplay": "corepack pnpm --filter @qa-sdk/roleplay-web dev",
    "demo": "concurrently -n reg,ing,shop,demo -c cyan,yellow,green,magenta \"corepack pnpm run dev:registry\" \"corepack pnpm run dev:ingest\" \"corepack pnpm run dev:shop\" \"corepack pnpm run dev:demo\"",
    "monitoring": "docker compose -f monitoring/docker-compose.monitoring.yml up -d && echo '  Prometheus: http://localhost:9090\n  Grafana: http://localhost:3000 (admin/admin)'",
    "monitoring:down": "docker compose -f monitoring/docker-compose.monitoring.yml down",
    "registry": "verdaccio --config verdaccio/config.yml",
    "publish:local": "bash scripts/publish-local.sh",
    "test:e2e": "corepack pnpm --filter @qa-sdk/e2e test:e2e",
    "sim:smoke": "./simulations/enterprise-pm/scripts/smoke.sh",
    "sim:smoke:keep": "./simulations/enterprise-pm/scripts/smoke.sh --keep-up",
    "sim:scenarios": "node ./simulations/enterprise-pm/scenarios/dist/cli.js",
    "sim:lint:identifiers": "tsx scripts/lint-identifiers.ts",
    "sim:canary": "tsx scripts/sim-canary.ts",
    "sim:scale": "tsx scripts/sim-scale.ts",
    "sim:smoke:full": "tsx scripts/sim-smoke-full.ts",
    "tax:ci": "corepack pnpm --filter taxonomy-engine build && corepack pnpm --filter taxonomy-engine typecheck && corepack pnpm --filter taxonomy-engine test && corepack pnpm --filter @qa-sdk/cli test taxonomy.test && node scripts/tax-validate-fixtures.mjs && node scripts/tax-doctor.mjs && node scripts/tax-codegen-drift.mjs && corepack pnpm --filter @qa-sdk/taxonomy-web build && corepack pnpm --filter @qa-sdk/taxonomy-web test",
    "tax:codegen:update": "node scripts/tax-codegen-drift.mjs --update"
  },
  "devDependencies": {
    "@qa-sdk/scaffold": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.59.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "js-yaml": "^4.1.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.62.0",
    "sim-identifier-grammar": "workspace:*",
    "sim-service-catalog": "workspace:*",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "verdaccio": "^6.5.2",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.30.3"
}
