{
  "name": "qa-sdk",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health.sh",
    "gate:event-taxonomy": "bash scripts/registry-event-taxonomy-gate.sh",
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:full": "QA_TEST_PG=1 SIM_SCENARIO_INPROC=1 pnpm -r --workspace-concurrency=1 run test",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint --fix packages/",
    "lint:ci": "oxlint --format=github --deny-warnings packages/",
    "format": "oxfmt packages/",
    "format:check": "oxfmt --check packages/",
    "arch:check": "npx tsx scripts/check-dependency-boundaries.ts",
    "arch:impact": "npx tsx scripts/api-impact-analyzer.ts",
    "arch:usage": "npx tsx scripts/analyze-package-usage.ts",
    "arch:identity": "npx tsx scripts/identifier-mapper.ts",
    "arch:signals": "npx tsx scripts/discover-event-flow.ts",
    "arch:surfaces": "node scripts/report-package-surfaces.mjs",
    "arch:feedback": "npx tsx scripts/ai-feedback-loop.ts",
    "arch:verify": "npx tsx scripts/verify-analysis-os.ts",
    "arch:manifest": "npx tsx scripts/generate-api-reference.ts",
    "clean": "pnpm -r run clean",
    "sync:skills": "bash scripts/sync-skills.sh",
    "def:check": "node packages/cli/dist/index.js def validate && node packages/cli/dist/index.js def audit-db",
    "docs:audit-quality": "node scripts/audit-doc-quality.mjs",
    "docs:usefulness-audit": "node scripts/design-usefulness-audit.mjs",
    "dev:ingest": "pnpm --filter @qa-sdk/ingest-server dev",
    "dev:registry": "pnpm --filter @qa-sdk/registry-service dev",
    "dev:shop": "pnpm --filter @qa-sdk/shop-web dev",
    "dev:demo": "pnpm --filter platform-demo dev",
    "dev:viz": "pnpm --filter @qa-sdk/viz-web dev",
    "dev:roleplay": "pnpm --filter @qa-sdk/roleplay-web dev",
    "demo": "concurrently -n reg,ing,shop,demo -c cyan,yellow,green,magenta \"pnpm dev:registry\" \"pnpm dev:ingest\" \"pnpm dev:shop\" \"pnpm dev:demo\"",
    "monitoring": "docker compose -f monitoring/docker-compose.monitoring.yml up -d && echo '  Prometheus: http://localhost:9090\n  Grafana: http://localhost:3000 (admin/admin)'",
    "monitoring:down": "docker compose -f monitoring/docker-compose.monitoring.yml down",
    "registry": "npx verdaccio --config verdaccio/config.yml",
    "publish:local": "bash scripts/publish-local.sh",
    "test:e2e": "pnpm --filter @qa-sdk/e2e test",
    "sim:smoke": "./simulations/enterprise-pm/scripts/smoke.sh",
    "sim:smoke:keep": "./simulations/enterprise-pm/scripts/smoke.sh --keep-up",
    "sim:scenarios": "node ./simulations/enterprise-pm/scenarios/dist/cli.js",
    "sim:lint:identifiers": "tsx scripts/lint-identifiers.ts",
    "sim:canary": "tsx scripts/sim-canary.ts",
    "sim:scale": "tsx scripts/sim-scale.ts",
    "sim:smoke:full": "tsx scripts/sim-smoke-full.ts",
    "tax:ci": "pnpm --filter taxonomy-engine build && pnpm --filter taxonomy-engine typecheck && pnpm --filter taxonomy-engine test && pnpm --filter @qa-sdk/cli test taxonomy.test && node scripts/tax-validate-fixtures.mjs && node scripts/tax-doctor.mjs && node scripts/tax-codegen-drift.mjs && pnpm --filter @qa-sdk/taxonomy-web build && pnpm --filter @qa-sdk/taxonomy-web test",
    "tax:codegen:update": "node scripts/tax-codegen-drift.mjs --update"
  },
  "devDependencies": {
    "@qa-sdk/scaffold": "workspace:*",
    "@typescript-eslint/parser": "^8.59.1",
    "commander": "^12.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.62.0",
    "protobufjs-cli": "^2.0.3",
    "sim-identifier-grammar": "workspace:*",
    "sim-service-catalog": "workspace:*",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1",
    "verdaccio": "^6.5.2",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.30.3"
}
