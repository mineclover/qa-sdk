{
  "name": "qa-sdk",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health.sh",
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "dev:ingest": "pnpm --filter @qa-sdk/ingest-server dev",
    "dev:registry": "pnpm --filter @qa-sdk/registry-service dev",
    "dev:shop": "pnpm --filter @qa-sdk/shop-web dev",
    "dev:demo": "pnpm --filter platform-demo dev",
    "dev:viz": "pnpm --filter @qa-sdk/viz-web dev",
    "dev:roleplay": "pnpm --filter @qa-sdk/roleplay-web dev",
    "demo": "concurrently -n reg,ing,shop,demo -c cyan,yellow,green,magenta \"pnpm dev:registry\" \"pnpm dev:ingest\" \"pnpm dev:shop\" \"pnpm dev:demo\"",
    "monitoring": "docker compose -f monitoring/docker-compose.monitoring.yml up -d && echo '  Prometheus: http://localhost:9090\n  Grafana: http://localhost:3000 (admin/admin)'",
    "monitoring:down": "docker compose -f monitoring/docker-compose.monitoring.yml down",
    "test:e2e": "pnpm --filter @qa-sdk/e2e test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "protobufjs-cli": "^2.0.0",
    "vitest": "^1.6.1"
  }
}
